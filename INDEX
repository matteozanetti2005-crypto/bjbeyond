<script>
/* STARFIELD */
(function(){
  const c=document.getElementById('starfield');
  const ctx=c.getContext('2d');
  let stars=[],W,H;
  function resize(){W=c.width=window.innerWidth;H=c.height=window.innerHeight}
  function init(){stars=[];for(let i=0;i<300;i++)stars.push({x:Math.random()*W,y:Math.random()*H,r:Math.random()*1.3+.15,a:Math.random()*Math.PI*2,spd:Math.random()*.005+.001,base:Math.random()*.5+.08})}
  function draw(){ctx.clearRect(0,0,W,H);stars.forEach(s=>{s.a+=s.spd;const al=s.base+(Math.sin(s.a)+1)/2*(1-s.base)*.75;ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,Math.PI*2);ctx.fillStyle=`rgba(255,255,255,${al})`;ctx.fill()});requestAnimationFrame(draw)}
  resize();init();draw();
  window.addEventListener('resize',()=>{resize();init()});
})();

/* NAV */
window.addEventListener('scroll',()=>document.getElementById('navbar').classList.toggle('scrolled',window.scrollY>40));
function toggleMenu(){document.getElementById('navLinks').classList.toggle('open')}
document.querySelectorAll('#navLinks a').forEach(a=>a.addEventListener('click',()=>document.getElementById('navLinks').classList.remove('open')));

/* REVEAL */
const io=new IntersectionObserver((entries)=>{
  entries.forEach((e,i)=>{if(e.isIntersecting){setTimeout(()=>e.target.classList.add('visible'),i*55);io.unobserve(e.target)}});
},{threshold:.1});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

/* COOKIE */
(function(){if(document.cookie.split(';').some(c=>c.trim().startsWith('bj_cookie_consent=')))document.getElementById('cookie-banner').classList.add('hidden')})();
function setCookieConsent(v){const d=new Date();d.setFullYear(d.getFullYear()+1);document.cookie=`bj_cookie_consent=${v};expires=${d.toUTCString()};path=/;SameSite=Lax`;document.getElementById('cookie-banner').classList.add('hidden')}
</script>

